# Customer Support Ticket Agent — Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.
#
# ── LLM / Model Endpoint ────────────────────────────────────────────────────
# Base URL for an OpenAI-compatible chat-completions endpoint.
# Default: Ollama running locally (ollama serve + ollama pull qwen2.5:3b)
LLM_BASE_URL=http://localhost:11434/v1

# API key — use "not-required" for local Ollama; set a real key for hosted APIs.
LLM_API_KEY=not-required

# Model name to request. Must be an open-source instruction-tuned model.
LLM_MODEL=qwen2.5:3b

# ── API Server ───────────────────────────────────────────────────────────────
# Used by the Streamlit UI to reach FastAPI.
API_BASE_URL=http://localhost:8000

API_HOST=127.0.0.1
API_PORT=8000

# ── Streamlit UI ─────────────────────────────────────────────────────────────
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# ── RAG / Vector Store ───────────────────────────────────────────────────────
# Directory where ChromaDB persists the vector index.
# This path is gitignored — do not commit it.
VECTOR_DB_PATH=.data/vector_db

# HuggingFace sentence-transformer model for embeddings (open-source, local).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB collection name (change when switching knowledge bases).
RAG_COLLECTION=customer-support

# Number of chunks to retrieve per query (increase for longer KB docs).
RAG_TOP_K=3
